# Copy to .env and adjust. Every field has a working default.

# --- Your EQL install folder (Logs/ and maps/ are found inside it).
#     The default is the launcher's standard path — adjust if you installed
#     the game somewhere else.
EQL_GAME_DIR=C:\Users\Public\Daybreak Game Company\Installed Games\EverQuest Legends

# EQL launched 2026-07-28. Exports written before this are BETA data —
# characters need not survive a launch, so the advisor flags them rather
# than treating them as merely stale. Change only for a test server.
EQL_LAUNCH_ISO=2026-07-28T00:00:00
# EQL_LOG_DIR=             # only if your logs live outside the game folder
# EQL_LOG_PATH=            # full-path override (wins over the dir scan)
# EQL_CHARACTER_NAME=      # prefer this character; else most recent log

# --- LLM for the Advisor/Companion (all optional — the app runs without one;
#     switch at runtime in the Advisor tab's Counsel selector)
LLM_PROVIDER=none          # none | lmstudio | openai | custom | anthropic | local | claude_cli | codex_cli
MODEL=                     # lmstudio/local model id (as LM Studio/Ollama shows it)
OPENAI_API_KEY=
OPENAI_MODEL=o3
# Any OpenAI-compatible endpoint. Grok (xAI) works here — no special
# support needed: CUSTOM_BASE_URL=https://api.x.ai/v1 with a grok-* model.
# Also Groq, OpenRouter, Gemini compat, or a box on your LAN.
# Setting the base URL adds a "Custom" option to the Counsel selector.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Ollama (LLM_PROVIDER=local): needs `pip install langchain-ollama` and
# `ollama pull <model>`. Point these at another machine if Ollama runs
# on your desktop while you play on a laptop.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Coding-agent CLIs (OPTIONAL): Claude Code and Codex run as one-off
#     subprocesses using their own subscription logins — no API key in the
#     app. Each works as the MAIN advisor (LLM_PROVIDER=claude_cli or
#     codex_cli) and as the 2nd/3rd check slots on the Advisor tab, in any
#     combination (e.g. LM Studio primary, Claude CLI 2nd, Codex CLI 3rd).
#     Model and effort here are only the DEFAULTS — both have pickers in
#     the Advisor tab and the Settings panel, and a choice made there wins.
# CLAUDE_CLI=claude          # path to claude/claude.exe if not on PATH
# CLAUDE_CLI_MODEL=claude-opus-5
# CLAUDE_CLI_EFFORT=high     # low | medium | high | xhigh | max
# CODEX_CLI=codex            # path to codex/codex.exe if not on PATH
# CODEX_CLI_MODEL=           # empty = whatever codex is configured to use
# CODEX_CLI_EFFORT=high      # none | low | medium | high | xhigh | max (model-dependent)
# CLI_TIMEOUT_S=600

# --- EQL MCP server (OPTIONAL: structured spell/AA data; wiki falls back to
#     plain HTTP without it)
# git clone https://github.com/ArtSabintsev/everquest-legends-mcp
# cd everquest-legends-mcp && npm install
MCP_ENABLED=true
MCP_SERVER_DIR=

# --- App
DATABASE_URL=sqlite:///./data/companion.db
FRONTEND_ORIGIN=http://localhost:3000
